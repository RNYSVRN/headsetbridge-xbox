<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HeadsetBridge.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HeadsetBridge"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
            <TextBlock Text="{local:Loc Key=Nav.About}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageDescriptionStyle}"
                       Text="{local:Loc Key=About.Description}" />

            <Border Style="{StaticResource CardStyle}" Padding="24">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/headsetbridge.ico" Width="56" Height="56" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{local:Loc Key=App.Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{local:Loc Key=About.Body}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{local:Loc Key=About.Links}" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel Spacing="4">
                <local:SettingsRow Glyph="&#xE943;" Header="{local:Loc Key=About.Upstream}" Description="{local:Loc Key=About.UpstreamDesc}">
                    <local:ExternalLink Content="{local:Loc Key=Common.Open}" Target="https://github.com/MGPersonalProfile/headsetbridge-for-xbox" />
                </local:SettingsRow>
                <local:SettingsRow Glyph="&#xE7FC;" Header="{local:Loc Key=About.RemotePlay}" Description="{local:Loc Key=About.RemotePlayDesc}">
                    <local:ExternalLink Content="{local:Loc Key=Common.Open}" Target="https://www.xbox.com/remoteplay" />
                </local:SettingsRow>
            </StackPanel>

            <TextBlock Margin="0,24,0,0" Style="{StaticResource SecondaryTextStyle}"
                       Text="{local:Loc Key=About.Disclaimer}" />
        </StackPanel>
    </ScrollViewer>
</Page>
